{
  "name": "giftexchanger",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "sh -c 'set -a && . ./.env && set +a && go run -C services/api .'",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "db:migrate": "./scripts/goose.sh up",
    "db:status": "./scripts/goose.sh status",
    "db:down": "./scripts/goose.sh down",
    "db:generate": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 generate -f services/api/sqlc.yaml",
    "types:generate": "go run -C services/api github.com/gzuidhof/tygo@v0.2.18 generate"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
