POSTGRES_USER=giftexchanger
POSTGRES_PASSWORD=giftexchanger
POSTGRES_DB=giftexchanger
POSTGRES_PORT=5432

# Host-run API and goose (pnpm db:migrate). Inside Compose the host is `db`.
DATABASE_URL=postgres://giftexchanger:giftexchanger@localhost:5432/giftexchanger?sslmode=disable

# Email via Resend. Leave RESEND_API_KEY unset to print login codes and invites
# to the API log instead. Keep MAIL_FROM quoted: .env is sourced by sh.
# RESEND_API_KEY=re_...
# MAIL_FROM="GiftExchanger <hello@contact.giftexchanger.app>"
